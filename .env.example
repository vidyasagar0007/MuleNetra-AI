# MuleTrace AI Environment Variables Example
# Copy this file to .env and configure as needed.

# Database URL
DATABASE_URL=sqlite:///data/muletrace.db

# LLM Provider: 'offline' (built-in rule-grounded forensic engine), 'ollama', or 'gemini'
LLM_PROVIDER=offline

# Local Ollama Settings (Optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# External API Keys (Optional - offline fallback is fully functional)
GEMINI_API_KEY=your_gemini_api_key_here
